{
  "name": "iron-front",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=cjs --outfile=dist-server/server.cjs --log-level=warning",
    "start": "node dist-server/server.cjs",
    "play": "node scripts/play.mjs",
    "server": "npm run build:server && node dist-server/server.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "phaser": "^3.90.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.3",
    "vite": "^6.3.5"
  }
}
